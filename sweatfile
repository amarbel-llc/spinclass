# vim: set ft=toml

[hooks]
# Per-commit repair at authoring time: each commit is formatted as it's made
# (docs/plans/2026-06-16-per-commit-repair-hook-design.md), replacing the
# merge-time REPAIR phase (FDR 0018). Rollback during the promotion window is a
# one-line swap back to `repair = "conformist --commit --amend --exit-zero-on-fix"`
# (+ disable-pre-commit = true). The `pre-merge = "just"` lint gate stays as the
# loud backstop that surfaces any drift the hook missed.
pre-commit = "conformist --staged --exit-zero-on-fix"
pre-merge  = "just"
