# vim: set ft=toml

[hooks]
# Per-commit repair at authoring time: each commit is formatted as it's made.
# The command is conformist's store-pinned toolchain wrapper
# `conformist-pre-commit` (conformist#59 mkToolchainHooks, on the devShell PATH
# via flake.nix) — NOT a bare `conformist --staged --exit-zero-on-fix` string:
# the wrapper bakes the conformist binary AND every formatter as store paths, so
# the hook can't break on a stale PATH conformist (the 0.1.6 regression) or
# silently skip a filetype whose formatter is missing from PATH (conformist#51).
# Requires the devShell active (the wrapper is a devShell PATH entry). The
# `pre-merge = "just"` lint gate stays as the loud backstop. See FDR 0019.
pre-commit = "conformist-pre-commit"
pre-merge  = "just"

# Per-worktree golangci-lint cache (conformist#34). golangci-lint replays
# per-package diagnostics whose embedded absolute paths point at whichever
# worktree populated the cache; a cache shared across worktrees — e.g. the
# merge hook's throwaway build worktree inheriting a session's path — makes
# nolint/generated-file suppression fail open and leaks spurious findings, a
# non-deterministic gate. Pinning the cache inside the worktree keeps every
# cached path valid for the worktree's lifetime and dies with it. The
# [linter.golangci-lint] conformist stanza reads this from the env.
#
# NB the bare [direnv] header is load-bearing: spinclass's tommy decoder only
# consumes [direnv.dotenv] when the parent table header is explicit (#113).
[direnv]

[direnv.dotenv]
GOLANGCI_LINT_CACHE = "$WORKTREE/.tmp/golangci-lint"
